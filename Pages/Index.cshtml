@page
@using dsv_mini.Meetingroom
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">DSV mødelokaler</h1>
</div>


    @foreach (Meeting item in Model.Meetings)
    {

        <div class=" card border-primary mb-3" style="max-width: 98rem;">
            <div class="card-header fw-bolder fs-3">@item.Name</div>
            <div class="card-body text-primary">
                <h5 class="card-title">Lokale: @item.Room</h5>
                <p class="card-text">I dette mødelokale er der plads til: @item.NumberOfSeats </p>
                <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-primary">
                    Book
                </a>
            </div>
        </div>
        
    }    
